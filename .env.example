# HASI - .env Example
# This is an example .env file for the HASI project. Copy this file to .env and fill in the values as needed.

# Port for Express to listen on
PORT=3000

# Domain for CORS (use "*" to allow all origins, or specify a domain like "https://wikdomain.com")
DOMAIN="*"

# Node environment (development or production)
NODE_ENV=development

# Feature flags for endpoint management
ENABLED_API_KEY_MANAGEMENT=true
ENABLED_USER_SESSION_MANAGEMENT=true
V2_DISABLED=false
